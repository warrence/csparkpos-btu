import React, { Component } from 'react';
import { View, Text } from 'react-native';
import { connect } from 'react-redux';
import {
  Container,
  Content,
  Grid,
  Row,
  Input,
  Button,
  Spinner,
  Form,
  Item,
  Label,
  Footer,
  FooterTab
} from 'native-base';
import { emailChanged, passwordChanged, loginUser } from '../actions';

class LoginForm extends Component {
  onEmailChange(text) {
    this.props.emailChanged(text);
  }

  onPasswordChange(text) {
    this.props.passwordChanged(text);
  }

  async onButtonPress() {
    const { email, password } = this.props;
    this.props.loginUser({ email, password });
  }

  renderError() {
    if (this.props.error) {
      return (
        <View style={{ backgroundColor: 'white' }}>
          <Text style={styles.errorTextStyle}>
            {this.props.error}
          </Text>
        </View>
      );
    }
  }

  renderButton() {
    if (this.props.loading) {
      return <Spinner size="large" />;
    }

    return (
      <Button rounded onPress={this.onButtonPress.bind(this)} style={styles.buttonStyle}>
        <Text style={{ color: 'white', fontWeight: 'bold' }}>Login</Text>
      </Button>
    );
  }

  render() {
    const { containerStyle, rowStyle, logoStyle } = styles;

    return (
      <Container style={containerStyle}>
        <Content>
          <Grid style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
            <Row style={rowStyle}>
              <Text style={logoStyle}>CS Park POS</Text>
            </Row>
            <Row style={rowStyle}>
              <Form style={{ width: 300 }}>
                <Item inlineLabel>
                  <Label>Username</Label>
                  <Input
                    onChangeText={this.onEmailChange.bind(this)}
                    value={this.props.email}
                  />
                </Item>
                <Item floatingLabel last>
                  <Label>Password</Label>
                  <Input
                    secureTextEntry
                    onChangeText={this.onPasswordChange.bind(this)}
                    value={this.props.password}
                  />
                </Item>
              </Form>
            </Row>
            <Row style={rowStyle}>
              {this.renderError()}
            </Row>
            <Row style={{ height: 30 }}>
            </Row>
            <Row style={rowStyle}>
              {this.renderButton()}
            </Row>
          </Grid>
        </Content>
        <Footer>
          <FooterTab>
            <Button vertical>
              <Text>Apps</Text>
            </Button>
          </FooterTab>
        </Footer>
      </Container>

    );
  }
}

const styles = {
  errorTextStyle: {
    fontSize: 20,
    alignSelf: 'center',
    color: 'red'
  },
  containerStyle: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: 'white'
  },
  rowStyle: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
  },
  logoStyle: {
    fontSize: 100,
    //fontWeight: 'bold',
    color: '#66B2DB',
    fontFamily: 'HelveticaNeue-CondensedBlack'
  },
  buttonStyle: {
    width: 200,
    justifyContent: 'center'
  }
};

const mapStateProps = ({ auth }) => {
  const { email, password, error, loading } = auth;
  return { email, password, error, loading };
};

export default connect(mapStateProps, {
  emailChanged,
  passwordChanged,
  loginUser
})(LoginForm);
